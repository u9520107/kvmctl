+/* WebRTC authenticates the leaf certificate by its SDP fingerprint, not a CA.
+ * REQUIRED in both roles also rejects a peer which sends no certificate.
+ * The callback runs before mbedTLS discards the certificate; KEEP_PEER_CERTIFICATE
+ * is not needed. A hash failure or absent/mismatched SDP pin always aborts.
+ */
+static int verify_remote_fingerprint(void *ctx, mbedtls_x509_crt *crt, int depth, uint32_t *flags)
+{
+    dtls_srtp_t *dtls = ctx;
+    if (depth != 0) return 0;
+    dtls->remote_fingerprint_verified = false;
+    const mbedtls_md_info_t *md = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
+    if (!crt || !md || !crt->raw.p || !crt->raw.len ||
+        mbedtls_md(md, crt->raw.p, crt->raw.len, dtls->verified_remote_digest) != 0) {
+        esp_peer_note_remote_fingerprint_rejection(dtls->ctx);
+        ESP_LOGE("PEER_FP", "PEER_FP_REJECT role=%s reason=certificate_hash_error",
+                 dtls->role == DTLS_SRTP_ROLE_CLIENT ? "client" : "server");
+        *flags |= MBEDTLS_X509_BADCERT_OTHER;
+        return MBEDTLS_ERR_X509_CERT_VERIFY_FAILED;
+    }
+    int match = esp_peer_remote_fingerprint_matches(dtls->ctx, dtls->verified_remote_digest);
+    if (match != 1) {
+        esp_peer_note_remote_fingerprint_rejection(dtls->ctx);
+        ESP_LOGE("PEER_FP", "PEER_FP_REJECT role=%s reason=%s",
+                 dtls->role == DTLS_SRTP_ROLE_CLIENT ? "client" : "server",
+                 match == 0 ? "pin_mismatch" : "pin_missing");
+        *flags |= MBEDTLS_X509_BADCERT_OTHER;
+        return MBEDTLS_ERR_X509_CERT_VERIFY_FAILED;
+    }
+    /* Exact leaf pin replaces CA/date policy for this WebRTC-only certificate.
+     * TLS CertificateVerify still validates possession of its private key.
+     */
+    *flags = 0;
+    dtls->remote_fingerprint_verified = true;
+    return 0;
+}
+
+static void require_remote_fingerprint(dtls_srtp_t *dtls)
+{
+    mbedtls_ssl_conf_authmode(&dtls->conf, MBEDTLS_SSL_VERIFY_REQUIRED);
+    mbedtls_ssl_conf_verify(&dtls->conf, verify_remote_fingerprint, dtls);
+}
 
